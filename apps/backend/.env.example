# ---------------------------------------------------------------------------
# Charcoal Business API — backend environment variables
#
# Copy this file to `.env` and fill in real values. The server validates these
# at startup (Joi) and will THROW and refuse to boot if any required variable
# is missing or invalid.
# ---------------------------------------------------------------------------

# Node runtime environment. Optional — defaults to "development".
# One of: development | production | test
NODE_ENV=development

# Second, independent gate for the local-dev auth bypass (Authorization:
# Bearer dev:<role> — see SETUP.md). The bypass requires BOTH
# NODE_ENV !== "production" AND this set to "true" — defaults to "false" so a
# forgotten/misconfigured NODE_ENV can never expose it on its own.
# Set to "true" here for local development. NEVER set this to "true" in any
# deployed/production environment.
DEV_AUTH_BYPASS_ENABLED=true

# REQUIRED. Postgres connection string used by Prisma.
# Local example shown; use your managed database URL in production.
DATABASE_URL="postgresql://user:password@localhost:5432/charcoal?connection_limit=5&pool_timeout=20&connect_timeout=10"

# REQUIRED. Server-side Clerk API key (used by @clerk/clerk-sdk-node).
# Use sk_test_... locally and sk_live_... in production.
CLERK_SECRET_KEY="sk_test_..."

# REQUIRED. Svix signing secret used to verify Clerk webhook signatures.
CLERK_WEBHOOK_SECRET="whsec_..."

# Optional. Clerk JWKS endpoint used to verify session JWTs.
# Defaults to https://api.clerk.com/v1/jwks if omitted. Production instances
# typically use an instance-specific URL.
CLERK_JWKS_URL="https://<your-clerk-domain>/.well-known/jwks.json"

# Optional. Frontend (Vite) Clerk publishable key. Not consumed by the backend,
# but kept here because the frontend shares this .env.
# Use pk_test_... locally and pk_live_... in production.
CLERK_PUBLISHABLE_KEY="pk_test_..."

# Optional. HTTP port the API listens on. Defaults to 3001.
PORT=3001

# Optional. Prisma connection-pool size and timeout tuning.
#
# connection_limit — max pooled connections Prisma opens to the database
#   per process.  On Railway Hobby / Render Free the Postgres plan allows
#   25–100 connections total.  Setting this to 5 leaves headroom for
#   multiple app replicas + admin/migration connections.
#   Rule of thumb: (max_db_connections / expected_replica_count) - 5.
#
# pool_timeout — seconds to wait for a free connection before throwing
#   "Unable to acquire connection" (default: 10 s).  20 s gives headroom
#   for bursty traffic without hanging forever.
#
# connect_timeout — seconds to wait when opening a fresh TCP connection to
#   the database host.
#
# Append these as query params to DATABASE_URL, e.g.:
#   DATABASE_URL="postgresql://user:pass@host:5432/db?connection_limit=5&pool_timeout=20&connect_timeout=10"
#
# Note: the DATABASE_URL Joi validator accepts these as a valid URI.

# Optional. Comma-separated list of origins the browser is allowed to send
# credentialled requests from. Defaults to the Vite dev server (port 5173)
# so local development works without any configuration.
#
# Production example (single origin):
#   CORS_ORIGINS="https://app.example.com"
#
# Staging + production (multiple origins):
#   CORS_ORIGINS="https://app.example.com,https://staging.example.com"
#
# Manual verification with curl:
#   # Should receive Access-Control-Allow-Origin: https://app.example.com
#   curl -i -H "Origin: https://app.example.com" \
#        http://localhost:3001/health
#
#   # Should receive no Access-Control-Allow-Origin header (origin rejected)
#   curl -i -H "Origin: https://attacker.example.com" \
#        http://localhost:3001/health
#
# IMPORTANT: Do NOT set this to "*" — browsers reject wildcard + credentials.
CORS_ORIGINS="http://localhost:5173"

# Optional. Legacy single-account Traqo Ocean (https://traqocontainer.com)
# API key. As of the multi-account tracking feature, this is used ONLY as a
# fallback for TRAQO_API_KEY_1 below (kept for continuity — you do not need
# to rename it). New setups should prefer TRAQO_API_KEY_1 directly.
# Never sent to the frontend, never logged, never stored in the database.
TRAQO_API_KEY=

# Optional. Up to 3 Traqo Ocean accounts, used by ContainerTrackingService
# for the "Refresh tracking" button on Container Detail. Each active
# container is automatically assigned to whichever account has the most
# free slots (max 4 active containers/account, seeded via prisma/seed.ts as
# TraqoAccount rows — see that file to change names/limits/priority). Get
# each key from that Traqo account's dashboard Developer tab (make sure
# Developer Mode is enabled there — the API returns 403 otherwise).
# Never sent to the frontend, never logged, never stored in the database —
# only the env var NAME (e.g. "TRAQO_API_KEY_1") is ever persisted, as
# TraqoAccount.envKeyName. If a given account's key is unset, that account
# is simply excluded from allocation — no crash, no other account affected.
# TRAQO_API_KEY_1 additionally falls back to TRAQO_API_KEY above if unset.
TRAQO_API_KEY_1=
TRAQO_API_KEY_2=
TRAQO_API_KEY_3=

# Optional. Traqo API base URL, shared by all 3 accounts above. Defaults to
# the documented production endpoint below — only override for pointing at
# a sandbox during testing.
TRAQO_BASE_URL="https://traqocontainer.com/api/v1"

# Optional. Shared, high-entropy secret protecting the mobile-only endpoints
# (POST /api/v1/mobile/devices) — the container-tracking mobile app is a
# private, single-user, login-free client with no Clerk session, so this
# static credential (sent as header X-Mobile-Api-Secret, baked into the app
# at build time) is its entire authorization story. The app boots fine
# without this set — mobile requests instead fail cleanly with 503
# "Mobile API is not configured" until it's provided. Generate with e.g.
# `openssl rand -base64 32`. NEVER commit a real value.
MOBILE_API_SECRET=

# Optional. Expo push notification "enhanced security" access token — not
# required for Expo's basic push-send API (https://exp.host/--/api/v2/push/send),
# only for Expo's opt-in stricter verification. Leave unset for a normal setup.
EXPO_ACCESS_TOKEN=

# Optional. Google Cloud project ID for the Cloud Translation API (v3
# Advanced), used by TranslationModule (POST /translations,
# GET /translations/languages). The app boots fine without this set —
# translation requests instead fail cleanly with "Translation is not
# configured" until it's provided.
GOOGLE_CLOUD_PROJECT_ID=

# Optional. Path to a Google Cloud service-account JSON key file, used for
# Application Default Credentials (ADC) — read directly by the
# @google-cloud/translate client library, not by this app's own code. Leave
# unset if you've run `gcloud auth application-default login` locally, or
# when deployed on GCP infrastructure with an attached service account
# (Cloud Run, GKE Workload Identity, etc.) — both provide ADC automatically.
# NEVER commit the file this points to, and never point it at a path inside
# this repo.
GOOGLE_APPLICATION_CREDENTIALS=
