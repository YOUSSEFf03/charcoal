# ---------------------------------------------------------------------------
# Charcoal Business API — backend environment variables
#
# Copy this file to `.env` and fill in real values. The server validates these
# at startup (Joi) and will THROW and refuse to boot if any required variable
# is missing or invalid.
# ---------------------------------------------------------------------------

# Node runtime environment. Optional — defaults to "development".
# One of: development | production | test
NODE_ENV=development

# REQUIRED. Postgres connection string used by Prisma.
# Local example shown; use your managed database URL in production.
DATABASE_URL="postgresql://user:password@localhost:5432/charcoal?connection_limit=5&pool_timeout=20&connect_timeout=10"

# REQUIRED. Server-side Clerk API key (used by @clerk/clerk-sdk-node).
# Use sk_test_... locally and sk_live_... in production.
CLERK_SECRET_KEY="sk_test_..."

# REQUIRED. Svix signing secret used to verify Clerk webhook signatures.
CLERK_WEBHOOK_SECRET="whsec_..."

# Optional. Clerk JWKS endpoint used to verify session JWTs.
# Defaults to https://api.clerk.com/v1/jwks if omitted. Production instances
# typically use an instance-specific URL.
CLERK_JWKS_URL="https://<your-clerk-domain>/.well-known/jwks.json"

# Optional. Frontend (Vite) Clerk publishable key. Not consumed by the backend,
# but kept here because the frontend shares this .env.
# Use pk_test_... locally and pk_live_... in production.
CLERK_PUBLISHABLE_KEY="pk_test_..."

# Optional. HTTP port the API listens on. Defaults to 3001.
PORT=3001

# Optional. Prisma connection-pool size and timeout tuning.
#
# connection_limit — max pooled connections Prisma opens to the database
#   per process.  On Railway Hobby / Render Free the Postgres plan allows
#   25–100 connections total.  Setting this to 5 leaves headroom for
#   multiple app replicas + admin/migration connections.
#   Rule of thumb: (max_db_connections / expected_replica_count) - 5.
#
# pool_timeout — seconds to wait for a free connection before throwing
#   "Unable to acquire connection" (default: 10 s).  20 s gives headroom
#   for bursty traffic without hanging forever.
#
# connect_timeout — seconds to wait when opening a fresh TCP connection to
#   the database host.
#
# Append these as query params to DATABASE_URL, e.g.:
#   DATABASE_URL="postgresql://user:pass@host:5432/db?connection_limit=5&pool_timeout=20&connect_timeout=10"
#
# Note: the DATABASE_URL Joi validator accepts these as a valid URI.

# Optional. Comma-separated list of origins the browser is allowed to send
# credentialled requests from. Defaults to the Vite dev server (port 5173)
# so local development works without any configuration.
#
# Production example (single origin):
#   CORS_ORIGINS="https://app.example.com"
#
# Staging + production (multiple origins):
#   CORS_ORIGINS="https://app.example.com,https://staging.example.com"
#
# Manual verification with curl:
#   # Should receive Access-Control-Allow-Origin: https://app.example.com
#   curl -i -H "Origin: https://app.example.com" \
#        http://localhost:3001/health
#
#   # Should receive no Access-Control-Allow-Origin header (origin rejected)
#   curl -i -H "Origin: https://attacker.example.com" \
#        http://localhost:3001/health
#
# IMPORTANT: Do NOT set this to "*" — browsers reject wildcard + credentials.
CORS_ORIGINS="http://localhost:5173"
