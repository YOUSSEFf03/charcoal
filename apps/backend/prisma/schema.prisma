model Client {
  id             String        @id @default(uuid())
  name           String
  /// Arabic display name — shown under `name` on ClientDetail's hero header.
  nameAr         String?
  type           ClientType
  currency       Currency
  phones         Json          @default("[]")
  preferredTypes Json          @default("[]")
  avgOrderDays   Decimal?      @db.Decimal(10, 2)
  lastOrderDate  DateTime?     @db.Date
  paymentTerms   String?
  /// Free-form address — informational only, never used in any calculation.
  address        String?
  /// Informational credit-limit figure (client's own currency) — display
  /// only; no order/invoice logic reads or enforces this anywhere.
  creditLimit    Decimal?      @db.Decimal(10, 2)
  /// Arabic notes.
  notes          String?
  /// English notes — separate from `notes` (Arabic) rather than one bilingual field.
  notesEn        String?
  isActive       Boolean       @default(true)
  /// Multiple-locations audit, 2026-08-31: opt-in switch that reveals the
  /// Locations management UI (ClientDetail.tsx) — a client stays a normal
  /// single-location client by default (Order forms never show a location
  /// selector unless this is true AND at least one active ClientLocation
  /// exists). The client's own financial account/balance is completely
  /// unaffected either way — see ClientLocation's doc comment: a location is
  /// provenance on an order, never a second ledger.
  multiLocationEnabled Boolean    @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orders         ClientOrder[]
  invoices       Invoice[]
  payments       Payment[]
  stockExits     StockExit[]
  fillJobs       FillJob[]
  locations      ClientLocation[]

  @@map("clients")
}

/// A named branch/location belonging to one client (e.g. "Hamra Branch"),
/// for provenance on normal Orders only (forensic audit, 2026-08-31 —
/// "Client Multiple Locations with ONE shared client balance").
///
/// CRITICAL — this is NOT an accounting entity: no balance, no ledger, no
/// AccountEntry ever references a location. The client remains the single
/// financial account (Client.balance / getClientLedger()) regardless of how
/// many locations it has or which one an order was placed for. Warehouse/
/// walk-in sales never reference this model at all (WalkInSalesService never
/// sets ClientOrder, let alone a location).
///
/// Never hard-deleted once it may have orders against it — deactivate
/// (isActive=false) instead, so ClientOrder.locationId keeps resolving for
/// historical Statement entries. Name is unique per-client (not globally) —
/// see ClientsService.createLocation()'s case-insensitive dup check, the
/// same "Fuel/fuel/FUEL" prevention pattern already used for ExpenseCategory.
model ClientLocation {
  id        String        @id @default(uuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  name      String
  address   String?
  phone     String?
  notes     String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  orders    ClientOrder[]

  @@unique([clientId, name])
  @@index([clientId])
  @@map("client_locations")
}

model ClientOrder {
  id               String           @id @default(uuid())
  displayId        String?          @unique @map("display_id")
  clientId         String
  client           Client           @relation(fields: [clientId], references: [id])
  charcoalType     String
  grade            String
  totalKgRequested Decimal          @db.Decimal(10, 3)
  bagTypeId        String?
  bagType          BagType?         @relation(fields: [bagTypeId], references: [id])
  pricePerBag      Decimal          @db.Decimal(10, 2)
  currency         Currency
  status           OrderStatus      @default(draft)
  driverId         String?          @map("driver_id") @db.Text
  driver           User?            @relation("OrderDriver", fields: [driverId], references: [id])
  createdById      String
  createdBy        User             @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  notes            String?
  supplierName     String?          @map("supplier_name")
  /// Which of the client's branches this order/delivery is for — informational
  /// provenance only (see ClientLocation's doc comment). Nullable: a normal
  /// single-location client (the default) never sets this; a historical order
  /// predating this feature keeps it null forever, never backfilled/invented.
  /// Never affects the client's shared balance/ledger math — only
  /// ReportsService.buildInvoiceDescription() reads it, to append the
  /// location name into the existing Statement description string.
  locationId       String?
  location         ClientLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  shipments        Shipment[]
  packingSessions  PackingSession[]
  stockExits       StockExit[]
  invoices         Invoice[]
  orderBagLines    OrderBagLine[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([locationId])
  @@map("client_orders")
}

model OrderBagLine {
