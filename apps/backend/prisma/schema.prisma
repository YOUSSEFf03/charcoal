// Charcoal Business Accounting System — Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  accountant
  sales_rep
  worker
  driver
  receiver
}

enum AccountEntryType {
  payment_received
  sale_collected
  handover
}

enum ContainerStatus {
  port
  transit
  arrived
}

enum CashHolderType {
  person
  drawer
  safe
  vehicle
  bank_account
  branch
}

enum StockSource {
  container
  direct
}

enum PackingMode {
  stock
  order
}

enum ClientType {
  restaurant
  shop
  wholesale
  walk_in
  corporate
  export
  fill_client
}

enum Currency {
  USD
  LBP
}

enum OrderStatus {
  draft
  confirmed
  partially_delivered
  delivered
  invoiced
  paid
}

enum ShipmentStatus {
  pending
  loaded
  delivered
  returned
  cancelled
}

enum TripStatus {
  planned
  in_progress
  completed
}

enum ExitType {
  order
  walk_in
  sample
  gift
  internal
  client_bags_fill
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  cancelled
}

enum InvoiceSource {
  ORDER
  WAREHOUSE_SALE
}

enum PaymentMethod {
  cash
  whish
  omt
  bank_transfer
  cheque
}

enum AdjustmentType {
  lot
  packed_stock
}

enum AdjustmentStatus {
  pending
  approved
  rejected
}

// Closed set of worker earnings categories — deliberately an enum, not free
// text, to keep worker-earnings reporting groupable (see WorkerCost.category).
// `correction` is the only path to amend a WorkerCost entry once its edit
// window has passed: post an offsetting entry rather than editing history.
enum WorkerCostCategory {
  daily_wage
  weekly_wage
  monthly_salary
  bonus
  deduction
  fuel
  food
  transport
  advance
  correction
  other
}

// Operational health of a TraqoAccount for allocation purposes. Distinct from
// slot capacity (activeCount vs maxContainers, always computed — never
// stored) — this tracks whether the account's credentials/quota are usable
// at all right now. See TraqoAccountAllocationService.
enum TraqoAccountStatus {
  healthy
  rate_limited
  auth_failed
  // 402 shipment_limit_reached / payment_overdue — Traqo itself reports the
  // account has no room or billing is unresolved. Distinct from
  // rate_limited (a request-pace problem, usually self-clearing in minutes)
  // and auth_failed (a bad key) — this one usually needs the operator to
  // check Traqo's own billing/dashboard.
  payment_required
}

model User {
  id                       String             @id @default(uuid())
  clerkId                  String             @unique
  email                    String             @unique
  name                     String
  role                     Role
  phone                    String?
  deletedAt                DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  containersCreated        Container[]        @relation("ContainerCreatedBy")
  containersFinalized      Container[]        @relation("ContainerFinalizedBy")
  expensesAdded            ContainerExpense[] @relation("ExpenseAddedBy")
  packingSessions          PackingSession[]   @relation("SessionWorker")
  stockAdjustmentsMade     StockAdjustment[]  @relation("AdjustmentCountedBy")
  stockAdjustmentsApproved StockAdjustment[]  @relation("AdjustmentApprovedBy")
  ordersCreated            ClientOrder[]      @relation("OrderCreatedBy")
  ordersAsDriver           ClientOrder[]      @relation("OrderDriver")
  supplierPaymentsLogged   SupplierPayment[]  @relation("SupplierPaymentLoggedBy")
  stockExitsLogged         StockExit[]        @relation("ExitLoggedBy")
  paymentsLogged           Payment[]          @relation("PaymentLoggedBy")
  bagPurchasesAdded        BagPurchase[]      @relation("BagPurchaseAddedBy")
  driverTrips              DriverTrip[]       @relation("TripDriver")
  cashHandovers            CashHandover[]     @relation("HandoverLoggedBy")
  paymentsReceived         Payment[]          @relation("PaymentReceivedBy")
  exitsCollected           StockExit[]        @relation("ExitCollectedBy")
  handoversReceived        CashHandover[]     @relation("HandoverReceiver")
  generalExpensesAdded     GeneralExpense[]   @relation("GeneralExpenseAddedBy")
  workerCostsLogged        WorkerCost[]       @relation("WorkerCostLoggedBy")
  account                  UserAccount?
  cashHolder               CashHolder?
  workerEntity              Worker?           @relation("WorkerUser")

  @@map("users")
}

model CashHandover {
  id           String   @id @default(uuid())
  date         DateTime @db.Date
  receiverName String
  receiverId   String?
  receiver     User?    @relation("HandoverReceiver", fields: [receiverId], references: [id])
  expectedAmt  Decimal  @db.Decimal(10, 2)
  handedAmt    Decimal  @db.Decimal(10, 2)
  difference   Decimal  @db.Decimal(10, 2)
  notes        String?
  loggedById   String
  loggedBy     User     @relation("HandoverLoggedBy", fields: [loggedById], references: [id])
  createdAt    DateTime @default(now())
  expenses     CashHandoverExpense[]

  @@index([date])
  @@index([receiverId])
  @@map("cash_handovers")
}

/// Itemized cash deducted before handover (e.g. gas, parking) — previously
/// calculated client-side only and discarded on submit. Persisted so these
/// real business expenses survive and can appear in the Expenses aggregation.
/// No own `date` field: derives its date from the parent CashHandover.date.
///
/// This is the single authoritative "expense occurrence" record for the
/// Expenses page's Employee → Category → Occurrence hierarchy (forensic
/// audit, 2026-08-31) — "employee" is this row's CashHandover.receiverId/
/// receiverName, "category" is `categoryId` below. No separate/duplicate
/// accounting record is ever created for the same occurrence.
model CashHandoverExpense {
  id             String           @id @default(uuid())
  cashHandoverId String
  cashHandover   CashHandover     @relation(fields: [cashHandoverId], references: [id], onDelete: Cascade)
  /// Human-readable label — kept in sync with `category.name` at write time
  /// (CashHandoversService.create()) so every existing reader of this column
  /// (reports.service.ts's P&L aggregate, CashHandover.tsx's history table)
  /// keeps working unchanged. Never independently editable once a category
  /// is selected — the category IS the description going forward.
  description    String
  amount         Decimal          @db.Decimal(10, 2)
  /// Nullable only so a pre-migration historical row (backfilled by
  /// 20260831000000_add_expense_category, matched from its own `description`)
  /// or a rare direct-API caller that omits it is never left in an invalid
  /// state — CreateCashHandoverDto.expenses[] requires it for every NEW row.
  categoryId     String?
  /// SetNull (not the default RESTRICT): no category-deletion feature exists
  /// today, but a historical expense occurrence must never be blocked or
  /// destroyed by a future category-management change — "nothing should be
  /// deleted or hidden permanently" (forensic audit, 2026-08-31).
  category       ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@index([cashHandoverId])
  @@index([categoryId])
  @@map("cash_handover_expenses")
}

/// Reusable expense category/type (e.g. "Fuel", "Food") — selected from a
/// dropdown when logging a Cash Handover expense, or created on the fly via
/// "+ Add new expense" (ExpenseCategoriesService.findOrCreate(), case-
/// insensitive so "Fuel"/"fuel"/"FUEL" never become three separate rows).
/// Reusable ONLY — never itself an accounting record; each actual expense
/// stays its own CashHandoverExpense occurrence.
model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  expenses  CashHandoverExpense[]

  @@map("expense_categories")
}

model Supplier {
  id               String                 @id @default(uuid())
  name             String
  country          String
  contactPersons   Json                   @default("[]")
  charcoalTypes    Json                   @default("[]")
  bankDetails      Json?
  paymentTerms     String?
  leadTimeDays     Int?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  containers       Container[]
  stockLots        StockLot[]
  productLines     ContainerProductLine[]
  supplierPayments SupplierPayment[]

  @@map("suppliers")
}

model SupplierPayment {
  id          String        @id @default(uuid())
  displayId   String?       @unique @map("display_id")
  supplierId  String        @map("supplier_id")
  supplier    Supplier      @relation(fields: [supplierId], references: [id])
  containerId String?       @map("container_id")
  container   Container?    @relation(fields: [containerId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  currency    Currency      @default(USD)
  method      PaymentMethod @default(bank_transfer)
  date        DateTime      @db.Date
  notes       String?
  loggedById  String        @map("logged_by_id")
  loggedBy    User          @relation("SupplierPaymentLoggedBy", fields: [loggedById], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([supplierId])
  @@index([date])
  @@map("supplier_payments")
}

model Container {
  id               String                 @id @default(uuid())
  number           String                 @unique
  supplierId       String
  supplier         Supplier               @relation(fields: [supplierId], references: [id])
  status           ContainerStatus        @default(port)
  arrivalDate      DateTime?
  notes            String?
  // Ocean carrier (shipping line) this container ships with, as a SCAC code
  // (e.g. "MAEU") plus its display name — set by the user via the existing
  // container edit flow, chosen from Traqo's live carrier list (never
  // free-typed or guessed from the container number). Required by
  // ContainerTrackingService before a Traqo lookup can be attempted; has no
  // effect on cost/accounting.
  sealine          String?
  sealineName      String?
  // Finalization: an ADDITIVE fact layered on top of `status`, never a
  // replacement for it. `status` keeps meaning exactly what it already
  // means (port/transit/arrived — physical state); finalizedAt/finalizedBy
  // answer a separate question ("is this arrived container's financial
  // record locked and historical?"). Both null = active; both set =
  // finalized. Never set independently of each other (see
  // ContainersService.finalize()). A finalized container's status is always
  // 'arrived' — finalization is only reachable from that status — but
  // status itself is never changed by finalization, by design (Option C of
  // the approved lifecycle audit).
  finalizedAt      DateTime?
  finalizedById    String?
  finalizedBy      User?                  @relation("ContainerFinalizedBy", fields: [finalizedById], references: [id])
  // ── Arrival push notification (Phase C — mobile tracking project) ─────
  // Set exactly once, the moment a "not arrived -> arrived" transition (see
  // ContainersService.update()) successfully notifies mobile devices. Never
  // set by container creation (a container created already-arrived has no
  // prior state to have "transitioned" from — mirrors ContainerTracking's
  // own 'initial' vs 'became_known' distinction from Phase B) and never set
  // from Traqo tracking data — only from this field's own business status.
  // The write is an atomic compare-and-set (`UPDATE ... WHERE status =
  // 'arrived' AND arrivalNotifiedAt IS NULL`), which is what makes the
  // notification idempotent even under concurrent update() calls.
  arrivalNotifiedAt DateTime?
  createdById      String
  createdBy        User                   @relation("ContainerCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  productLines     ContainerProductLine[]
  expenses         ContainerExpense[]
  discount         ContainerDiscount?
  stockLots        StockLot[]
  supplierPayments SupplierPayment[]
  tracking         ContainerTracking?
  trackingAssignments ContainerTrackingAssignment[]

  @@index([status])
  @@index([supplierId])
  @@index([finalizedAt])
  @@map("containers")
}

/// Last known shipment-tracking snapshot for a container, sourced from an
/// external tracking provider (currently Traqo Ocean). One row per
/// container, overwritten in place on every successful manual refresh —
/// this is a cache of the provider's last successful response, never a
/// history log. Purely informational: nothing here feeds cost, stock, or
/// accounting, and it must never be conflated with Container.status (the
/// internal port/transit/arrived lifecycle).
model ContainerTracking {
  id                String    @id @default(uuid())
  containerId       String    @unique
  container         Container @relation(fields: [containerId], references: [id])
  // "traqo" today; kept so a future second provider (or a swap) doesn't
  // require a schema change, only a new value here.
  provider          String    @default("traqo")
  referenceNumber   String
  sealine           String
  sealineName       String?
  status            String?
  origin            String?
  destination       String?
  vessel            String?
  voyage            String?
  currentLocation   String?
  eta               DateTime?
  isDelayed         Boolean?
  shipmentUid       String?
  shipmentPublicUrl String?
  // The real Traqo shipment identifier (Frappe doc name, e.g. "SHP-76810"),
  // extracted from the container response's nested rows. NOT the same as
  // shipmentUid above (that's a public-share-link token, confirmed by a live
  // GET /shipments/{shipmentUid} 404 during the multi-account investigation
  // — GET /shipments/{traqoShipmentName} is what actually resolves). Kept
  // separate rather than replacing shipmentUid, which the public tracking
  // link still depends on.
  traqoShipmentName String?
  // Traqo's own shipment-lifecycle fields, live-verified on GET
  // /container/:number (2026-08-26): is_active (0/1) and closed_at
  // (timestamp|null) are the confirmed signal that Traqo has closed/removed
  // a shipment — see ContainerTrackingAssignment.releaseReason
  // "traqo_removed". Never inferred from Container.status.
  isActive          Boolean?
  closedAt          DateTime?
  // Traqo's own `last_updated_at` for this shipment — distinct from
  // `lastFetchedAt`, which is when WE last successfully called the API.
  providerUpdatedAt DateTime?
  lastFetchedAt     DateTime  @default(now())
  // ── ETA-change detection (Phase B — mobile tracking project) ──────────
  // Snapshot of `eta` immediately before the most recent successful refresh
  // overwrote it. Captured on EVERY successful refresh, not only when it
  // changes — see ContainerTrackingService.persistSuccess()/classifyEtaChange().
  // Distinct from `eta` (the current authoritative value): this is "what it
  // used to be," kept so a future notification can say "previous ETA: X,
  // new ETA: Y" even though `eta` itself has already been overwritten with Y.
  // Null exactly when there is no known prior ETA (first-ever refresh, or
  // the prior refresh's eta was itself null).
  previousEta         DateTime?
  // Set to the refresh's timestamp only when that refresh's classification
  // was 'became_known' or 'changed' (see classifyEtaChange) — i.e. an actual
  // notification-worthy ETA change. Left untouched (keeps whatever it was)
  // on every other refresh, including 'no_change', the first-ever 'initial'
  // population, and 'became_unavailable' (ETA reverting to null is
  // deliberately NOT treated as an ordinary ETA-change event — see the
  // Phase B design notes). So this always reflects "the last time eta
  // meaningfully changed," never merely "the last refresh."
  etaChangedAt        DateTime?
  // Reserved for Phase C (push notifications) — never written by Phase B.
  // Set when a notification has actually been sent for the change recorded
  // at etaChangedAt. Phase C's dedup rule: a not-yet-notified change exists
  // iff etaChangedAt IS NOT NULL AND (etaChangeNotifiedAt IS NULL OR
  // etaChangeNotifiedAt < etaChangedAt). Defined now so Phase C needs no
  // further migration.
  etaChangeNotifiedAt DateTime?
  // Business-friendly message from the most recent FAILED refresh attempt,
  // if any. Cleared on the next successful refresh. The fields above are
  // never overwritten by a failed refresh — this is the only trace of it.
  lastError         String?
  // Full provider response, preserved verbatim. Nested-table field names
  // (events_table/vessels_table/voyage_plan_table) are best-effort mapped
  // above from public docs; this lets normalization be corrected later
  // without another API call, and is never sent to the frontend.
  rawResponse       Json
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  events            TrackingEvent[]

  @@map("container_trackings")
}

/// One tracking milestone from the provider's events_table, replaced in full
/// on every successful refresh (never diffed/appended) since the provider
/// returns the complete timeline each time, not deltas.
model TrackingEvent {
  id          String            @id @default(uuid())
  trackingId  String
  tracking    ContainerTracking @relation(fields: [trackingId], references: [id], onDelete: Cascade)
  description String
  location    String?
  occurredAt  DateTime?
  raw         Json?
  createdAt   DateTime          @default(now())

  @@index([trackingId])
  @@map("tracking_events")
}

/// One Traqo Ocean account/API key our backend can use to track containers.
/// The raw key itself is NEVER stored here — only `envKeyName`, a reference
/// to the environment variable holding it (see TraqoKeyResolver). This is a
/// deliberate structural guarantee: since there is no key column, a key can
/// never leak into a Prisma response, a DB export, or an admin UI.
model TraqoAccount {
  id               String                         @id @default(uuid())
  name             String
  envKeyName       String                         @unique
  baseUrl          String?
  active           Boolean                        @default(true)
  maxContainers    Int                             @default(4)
  // Deterministic tie-break ordering for allocation when multiple accounts
  // have equal active-container counts. Lower = preferred.
  priority         Int
  status           TraqoAccountStatus              @default(healthy)
  // Cool-down window for a temporary rate_limited state — accounts are
  // excluded from NEW allocation while this is in the future. Never affects
  // already-assigned containers.
  unavailableUntil DateTime?
  lastFailureAt    DateTime?
  lastFailureKind  String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  assignments      ContainerTrackingAssignment[]

  @@map("traqo_accounts")
}

/// Which TraqoAccount a container's Traqo tracking is billed/counted
/// against. Deliberately separate from Container and ContainerTracking (see
/// the multi-account architecture plan, §5): account routing is internal
/// integration plumbing, and release must only ever touch this table so
/// ContainerTracking/TrackingEvent history is preserved by construction.
/// Rows are never deleted — releasedAt marks history instead.
model ContainerTrackingAssignment {
  id             String        @id @default(uuid())
  containerId    String
  container      Container     @relation(fields: [containerId], references: [id], onDelete: Restrict)
  traqoAccountId String
  traqoAccount   TraqoAccount  @relation(fields: [traqoAccountId], references: [id], onDelete: Restrict)
  assignedAt     DateTime      @default(now())
  // NULL = active, consumes one of the account's maxContainers slots.
  // Non-null = released; the container no longer counts against the account.
  releasedAt     DateTime?
  // "traqo_removed" (Traqo confirmed is_active=0/closed_at!=null on a
  // refresh) | "manual" (admin override escape hatch). Never "arrived" —
  // Container.status reaching 'arrived' deliberately does NOT release.
  releaseReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([traqoAccountId, releasedAt])
  @@index([containerId])
  @@map("container_tracking_assignments")
}

model ContainerProductLine {
  id           String     @id @default(uuid())
  containerId  String
  container    Container  @relation(fields: [containerId], references: [id])
  charcoalType String
  grade        String
  supplierId   String
  supplier     Supplier   @relation(fields: [supplierId], references: [id])
  paidBags     Int
  giftBags     Int        @default(0)
  kgPerBag     Decimal    @db.Decimal(10, 3)
  pricePerTon  Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  stockLots    StockLot[]

  // Composite index covers both `WHERE supplierId = ?` alone (leftmost-prefix match)
  // and `WHERE supplierId = ? AND createdAt BETWEEN ? AND ?` — the two access
  // patterns the Supplier Statement query uses. A separate single-column
  // supplierId index would be redundant given this composite already serves it.
  @@index([supplierId, createdAt])
  @@map("container_product_lines")
}

model ContainerExpense {
  id          String    @id @default(uuid())
  containerId String
  container   Container @relation(fields: [containerId], references: [id])
  description String
  amount      Decimal   @db.Decimal(10, 2)
  addedById   String
  addedBy     User      @relation("ExpenseAddedBy", fields: [addedById], references: [id])
  addedAt     DateTime  @default(now())

  @@map("container_expenses")
}

model ContainerDiscount {
  id          String    @id @default(uuid())
  containerId String    @unique
  container   Container @relation(fields: [containerId], references: [id])
  amount      Decimal   @db.Decimal(10, 2)

  @@map("container_discounts")
}

model StockLot {
  id               String                @id @default(uuid())
  charcoalType     String
  grade            String
  supplierId       String
  supplier         Supplier              @relation(fields: [supplierId], references: [id])
  kgReceived       Decimal               @db.Decimal(10, 3)
  kgRemaining      Decimal               @db.Decimal(10, 3)
  costPerKg        Decimal               @db.Decimal(10, 4)
  source           StockSource
  containerId      String?
  container        Container?            @relation(fields: [containerId], references: [id])
  productLineId    String?
  productLine      ContainerProductLine? @relation(fields: [productLineId], references: [id])
  dateReceived     DateTime              @db.Date
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  sessionLots      PackingSessionLot[]
  fillJobLots      FillJobLot[]
  packedStocks     PackedStock[]
  rawExits         StockExit[]           @relation("RawLotExits")
  stockAdjustments StockAdjustment[]

  @@index([charcoalType, grade])
  @@index([supplierId])
  @@index([kgRemaining])
  @@index([containerId])
  @@index([productLineId])
  @@map("stock_lots")
}

model BagType {
  id            String         @id @default(uuid())
  name          String         @unique
  nominalKg     Decimal        @db.Decimal(10, 3)
  costPerBag    Decimal        @db.Decimal(10, 4)
  workerRate    Decimal        @db.Decimal(10, 4)
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bagPurchases  BagPurchase[]
  packedStocks  PackedStock[]
  orderBagLines OrderBagLine[]
  shipmentBags  ShipmentBag[]
  stockExits    StockExit[]
  clientOrders  ClientOrder[]

  @@map("bag_types")
}

model BagPurchase {
  id        String   @id @default(uuid())
  bagTypeId String
  bagType   BagType  @relation(fields: [bagTypeId], references: [id])
  quantity  Int
  unitCost  Decimal  @db.Decimal(10, 4)
  totalCost Decimal  @db.Decimal(10, 2)
  /// BUG-L (P5): currency of unitCost/totalCost. Local packaging suppliers may invoice in
  /// LBP. Defaults USD. P&L converts LBP bag cost to USD by the stored rate.
  currency  Currency @default(USD)
  date      DateTime @db.Date
  addedById String
  addedBy   User     @relation("BagPurchaseAddedBy", fields: [addedById], references: [id])
  notes     String?

  @@index([date])
  @@index([bagTypeId])
  @@map("bag_purchases")
}

model PackedStock {
  id               String                @id @default(uuid())
  lotId            String
  lot              StockLot              @relation(fields: [lotId], references: [id])
  bagTypeId        String
  bagType          BagType               @relation(fields: [bagTypeId], references: [id])
  quantity         Int
  /// BUG-I (P1): denormalized cache of Σ(reservations.quantity) for this row, kept in
  /// lockstep with the keyed ShipmentReservation rows. FREE quantity = quantity −
  /// reservedQuantity. Never mutated independently of a reservation row.
  reservedQuantity Int                   @default(0)
  sessionId        String
  session          PackingSession        @relation(fields: [sessionId], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  stockExits       StockExit[]
  adjustments      StockAdjustment[]
  reservations     ShipmentReservation[]

  @@index([bagTypeId])
  @@index([lotId])
  @@index([sessionId])
  @@map("packed_stocks")
}

/// BUG-I (P1): per-shipment reservation. Pins reserved bags to the shipment that holds
/// them so a release can never free another shipment's reservation on a shared bag-type
/// row. createShipment creates these FIFO; confirmDelivery / cancelShipment / logReturn
/// release only the rows belonging to that shipment. PackedStock.reservedQuantity is the
/// denormalized Σ(quantity) of a row's reservations and moves only with these rows.
model ShipmentReservation {
  id            String      @id @default(uuid())
  shipmentId    String
  shipment      Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  packedStockId String
  packedStock   PackedStock @relation(fields: [packedStockId], references: [id])
  quantity      Int
  createdAt     DateTime    @default(now())

  @@unique([shipmentId, packedStockId])
  @@index([shipmentId])
  @@index([packedStockId])
  @@map("shipment_reservations")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

enum DevicePlatform {
  ios
  android
}

/// A registered mobile push-notification target (Phase C — mobile tracking
/// project). Deliberately has NO relation to User: the mobile app is a
/// private, single-user, login-free client (see the mobile-app product
/// decision) authenticated by a shared device credential, not a Clerk
/// session — there is no per-user identity to attach a device to. `token`
/// is the Expo push token (never a Traqo key, never a Clerk credential —
/// this table has nothing to do with either). Unique on `token` so
/// re-registering the same device (app reinstall, token refresh handled
/// client-side by re-POSTing) is a plain upsert, never a duplicate row.
model DeviceToken {
  id         String         @id @default(uuid())
  token      String         @unique
  platform   DevicePlatform
  appVersion String?
  // Flipped to false only when the push provider definitively reports this
  // token as invalid/unregistered (e.g. Expo's DeviceNotRegistered) — never
  // for a transient send failure. Inactive devices are skipped when sending,
  // never deleted (keeps the row as a record of "this device existed").
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lastSeenAt DateTime       @default(now())

  @@map("device_tokens")
}

