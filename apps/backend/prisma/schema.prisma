model StockExit {
  id              String       @id @default(uuid())
  packedStockId   String?
  packedStock     PackedStock? @relation(fields: [packedStockId], references: [id])
  bagTypeId       String?
  bagType         BagType?     @relation(fields: [bagTypeId], references: [id])
  quantity        Int?
  lotId           String?
  lot             StockLot?    @relation("RawLotExits", fields: [lotId], references: [id])
  kgQuantity      Decimal?     @db.Decimal(10, 3)
  exitType        ExitType
  reason          String?
  recipient       String?
  orderId         String?
  order           ClientOrder? @relation(fields: [orderId], references: [id])
  clientId        String?
  client          Client?      @relation(fields: [clientId], references: [id])
  /// Links this exit back to the invoice that priced it (registered-client
  /// warehouse sales via WalkInSalesService). Display-only — never used to
  /// derive `amount` itself, so the P&L walk-in aggregate stays untouched.
  invoiceId       String?
  invoice         Invoice?     @relation(fields: [invoiceId], references: [id])
  amount          Decimal?     @db.Decimal(10, 2)
  /// BUG-K (P5): currency of `amount` for amount-bearing exits (anonymous walk-in / by-kg
  /// cash sales). Defaults USD. P&L converts LBP exits to USD by the stored rate. Exits
  /// with amount=null (invoice-linked walk-ins, BUG-A) ignore this.
  currency        Currency     @default(USD)
  collectedBy     String?
  collectedById   String?
  collectedByUser User?        @relation("ExitCollectedBy", fields: [collectedById], references: [id])
  loggedById      String
  loggedBy        User         @relation("ExitLoggedBy", fields: [loggedById], references: [id])
  date            DateTime     @db.Date
  createdAt       DateTime     @default(now())
  /// Client-generated key identifying one logical anonymous-walk-in-sale
  /// submission attempt (WarehouseSales.tsx's saleIdempotencyKey — same
  /// per-attempt UUID already used for registered-client sales via
  /// Invoice.idempotencyKey). Only ever set by StockExitsService.create()
  /// when the caller supplies one; every other exit type/caller (sample,
  /// internal, gift, fill-job pickup, direct API calls that omit it) leaves
  /// this null and is completely unaffected. See StockExitsService.create()'s
  /// doc comment for the full mechanism — it mirrors WalkInSalesService's
  /// idempotencyKey/requestFingerprint pattern for the anonymous-sale path
  /// that pattern was never extended to (forensic audit, 2026-08-28).
  ///
  /// Nullable + a plain unique index: Postgres allows unlimited NULLs, so
  /// every existing/other exit is unaffected. Unlike Invoice, StockExit has
  /// no cancel/void concept — a plain (not partial) unique index is
  /// therefore sufficient; there is no "cancelled" state that would need a
  /// key to become reusable.
  idempotencyKey     String?
  /// SHA-256 of the fields that define WHAT is being exited/collected —
  /// never display-only fields (recipient, reason) or the idempotencyKey
  /// itself. See computeStockExitFingerprint() in stock-exits.service.ts.
  /// A SECOND request reusing the same idempotencyKey with a genuinely
  /// DIFFERENT fingerprint is rejected (409 IDEMPOTENCY_KEY_REUSED), never
  /// silently treated as a retry.
  requestFingerprint String?

  @@index([date])
  @@index([exitType])
  @@index([packedStockId])
  @@index([orderId])
  @@index([clientId])
  @@index([lotId])
  @@index([invoiceId])
  @@map("stock_exits")
}

model Invoice {
  id                   String        @id @default(uuid())
  displayId            String?       @unique @map("display_id")
  orderId              String?
  order                ClientOrder?  @relation(fields: [orderId], references: [id])
  /// Client-generated key identifying one logical creation attempt — currently
  /// only WalkInSalesService.create() sets this (a walk-in sale has no
  /// pre-existing persistent entity like ClientOrder to key idempotency off of,
  /// unlike createFromOrder()'s orderId). This is the DB-level backstop for the
  /// application-level idempotency guard in WalkInSalesService.create() — see
  /// that method's doc comment for the full mechanism.
  ///
  /// NOT marked @unique here — the real constraint is a PARTIAL unique index,
  /// `invoices_idempotencyKey_unique_active` (WHERE status <> 'cancelled'),
  /// applied via raw SQL migration only (Prisma's schema DSL cannot express a
  /// filtered unique index), exactly mirroring how `orderId` above is a plain
  /// field with its own partial index (`invoices_orderId_unique_active`)
  /// applied the same way. Postgres allows unlimited NULLs in a unique index
  /// regardless, so every other invoice-creation path (ORDER source, any
  /// walk-in caller that omits the key) stays unaffected. The `<> 'cancelled'`
  /// clause lets a cancelled invoice keep its historical key permanently while
  /// still allowing a FRESH sale to reuse that same key — a plain unique index
  /// would instead permanently block that key on cancellation, which is the
  /// exact bug this partial-index migration exists to fix (forensic audit,
  /// 2026-08-27: create → cancel → retry same key must create a NEW live sale,
  /// not resurrect or get blocked by the cancelled one).
  idempotencyKey       String?
  /// SHA-256 of the semantically-relevant fields of the request that created
  /// this invoice under idempotencyKey (client, date, method, amounts,
  /// receiver, normalized bag/kg lines — see WalkInSalesService's
  /// computeSaleFingerprint()). NOT itself unique/constrained — it exists so a
  /// SECOND request reusing the same idempotencyKey with genuinely DIFFERENT
  /// sale data can be detected and rejected (IDEMPOTENCY_KEY_REUSED) instead
  /// of silently handing that caller someone else's sale result. Only ever
  /// compared, never enforced at the DB level (no legitimate reason two DIFFERENT
  /// keys would need distinct fingerprints — collisions across unrelated keys
  /// are harmless and never compared against each other).
  requestFingerprint   String?
  clientId             String
  client               Client        @relation(fields: [clientId], references: [id])
  lines                Json          @default("[]")
  subtotal             Decimal       @db.Decimal(10, 2)
  total                Decimal       @db.Decimal(10, 2)
  currency             Currency
  /// Identifies the business flow that created this invoice.
  /// ORDER         = invoice raised against a customer order (shipment-based delivery).
  /// WAREHOUSE_SALE = invoice raised from a direct warehouse sale (walk-in, no prior order).
  /// Defaults ORDER so that all invoices created before this field existed are treated
  /// as order invoices (correct — the walk-in invoice path was added later).
  source               InvoiceSource @default(ORDER)
  /// BUG-J (P5): LBP-per-USD exchange rate captured at issue time. P&L converts this
  /// invoice's LBP revenue using its OWN snapshot, not today's global rate, so past
  /// revenue is stable when the global rate changes. Null only for never-issued drafts
  /// (which never contribute to P&L). USD invoices ignore it.
  exchangeRateSnapshot Decimal?      @db.Decimal(18, 6)
  status               InvoiceStatus @default(draft)
  paidAmount           Decimal       @default(0) @db.Decimal(10, 2)
  issuedAt             DateTime?
  dueDate              DateTime?     @db.Date
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  payments             Payment[]
  stockExits           StockExit[]
  /// Authoritative record of how much of which payments applied to this invoice.
  /// paidAmount/status are a cache recomputed FROM this — see PaymentAllocation.
  allocations          PaymentAllocation[]

  @@index([clientId])
  @@index([status])
  @@index([issuedAt])
  @@index([orderId])
  @@index([createdAt])
  @@map("invoices")
}

model Payment {
  id           String        @id @default(uuid())
  displayId    String?       @unique @map("display_id")
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  /// Legacy/API-compat single-invoice link. Nullable: null means the payment
  /// was made at the client level (not tied to one invoice at creation time).
  /// PaymentAllocation — not this field — is authoritative for how the
  /// payment's amount was actually applied across invoice(s); this field is
  /// preserved as-is once set and is never rewritten by allocation logic.
  invoiceId    String?
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  amount       Decimal       @db.Decimal(10, 2)
  currency     Currency
  method       PaymentMethod
  date         DateTime      @db.Date
  loggedById   String
  loggedBy     User          @relation("PaymentLoggedBy", fields: [loggedById], references: [id])
  notes        String?
  receiverName String?
  receiverId   String?
  receiver     User?         @relation("PaymentReceivedBy", fields: [receiverId], references: [id])
  createdAt    DateTime      @default(now())
  /// How this payment's amount was actually applied across invoice(s) —
  /// see PaymentAllocation. A directly-linked payment (invoiceId set) still
  /// gets exactly one allocation row here; this is the single source of
  /// truth either way, invoiceId is kept only for API/back-compat.
  allocations  PaymentAllocation[]

  @@index([clientId])
  @@index([date])
  @@index([receiverName])
  @@index([invoiceId])
  @@map("payments")
}

/// One row = "this much of this payment applied to this invoice."
/// A single Payment can have multiple rows (split across invoices, e.g. FIFO
/// allocation of an unlinked client-level payment) or exactly one (a payment
/// created with invoiceId set — Payment.amount always goes to that one invoice).
/// Authoritative source for Invoice.paidAmount/status — see
/// InvoiceCalculatorService.recomputeStatus(). NOT used for client-level
/// balance/outstanding (that stays Payment-based, per CONSTRAINT 15 —
/// ClientBalanceService/getArSummary sum Payment.amount directly, never
/// allocations, so one payment is never counted twice at the client level).
/// invariants (enforced transactionally in PaymentAllocationService, not by
/// a cross-row DB constraint — see that service for why):
///   SUM(amount) WHERE paymentId = X <= that Payment.amount
///   SUM(amount) WHERE invoiceId = X <= that Invoice.total (FIFO path only —
///     a directly-linked payment is allowed to overpay its invoice, matching
///     pre-existing behavior for that path)
model PaymentAllocation {
  id        String   @id @default(uuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model Worker {
  id              String           @id @default(uuid())
