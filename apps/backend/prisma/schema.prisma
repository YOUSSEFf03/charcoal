  actualKg     Decimal?              @db.Decimal(10, 3)
  status       ShipmentStatus        @default(pending)
  deliveredAt  DateTime?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
