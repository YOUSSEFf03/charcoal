# Copy this file to .env for local development. Real values go in .env only
# (already gitignored — see apps/mobile/.gitignore) and are inlined into the
# JS bundle at build time by Expo's EXPO_PUBLIC_* convention. Never commit
# real values here.

# Must include the /api/v1 prefix, matching the web app's VITE_API_URL convention.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Must match the backend's MOBILE_API_SECRET env var exactly (see
# apps/backend/.env.example). Generate a high-entropy value once and reuse
# it in both places; never type this into the app itself, there is no login UI.
EXPO_PUBLIC_MOBILE_API_SECRET=
