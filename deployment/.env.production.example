# TEMPLATE ONLY. Copy to /opt/farah-charcoal/.env.production on the server.
# Never commit the real .env.production file.
NODE_ENV=production
DEV_AUTH_BYPASS_ENABLED=false

POSTGRES_DB=farah_charcoal
POSTGRES_USER=farah_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Must match the Compose service/network values:
DATABASE_URL=postgresql://farah_app:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@db:5432/farah_charcoal?connection_limit=5&pool_timeout=20&connect_timeout=10

# Clerk PRODUCTION instance credentials. Keep secret keys only on the server.
CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# Browser uses same-origin /api/v1, so no public API URL is needed.
VITE_API_URL=/api/v1

# Optional integrations; leave blank if not used.
TRAQO_API_KEY=
TRAQO_API_KEY_1=
TRAQO_API_KEY_2=
TRAQO_API_KEY_3=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
EXPO_ACCESS_TOKEN=
MOBILE_API_SECRET=
