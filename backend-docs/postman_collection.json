{
  "info": {
    "name": "Charcoal Business Accounting System",
    "description": "Complete API collection for the Charcoal Business Accounting System. All routes require Bearer JWT from Clerk except /health and /webhooks/clerk.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "AUTH_TOKEN", "value": "YOUR_CLERK_JWT_HERE", "type": "string" },
    { "key": "SUPPLIER_ID", "value": "supplier-001", "type": "string" },
    { "key": "CONTAINER_ID", "value": "container-001", "type": "string" },
    { "key": "LOT_ID", "value": "lot-001", "type": "string" },
    { "key": "BAG_TYPE_ID", "value": "bagtype-2kg", "type": "string" },
    { "key": "CLIENT_ID", "value": "client-001", "type": "string" },
    { "key": "ORDER_ID", "value": "order-001", "type": "string" },
    { "key": "INVOICE_ID", "value": "invoice-001", "type": "string" },
    { "key": "SHIPMENT_ID", "value": "shipment-001", "type": "string" },
    { "key": "TRIP_ID", "value": "trip-001", "type": "string" },
    { "key": "WORKER_ID", "value": "worker-001", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{AUTH_TOKEN}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/health", "host": ["{{BASE_URL}}"], "path": ["health"] }
          },
          "response": [
            {
              "name": "OK",
              "status": "OK",
              "code": 200,
              "body": "{\"status\":\"ok\",\"database\":\"connected\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/auth/me", "host": ["{{BASE_URL}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "List Users (owner only)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/users", "host": ["{{BASE_URL}}"], "path": ["users"] }
          }
        },
        {
          "name": "Update User Role (owner only)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/users/{{USER_ID}}/role" },
            "body": {
              "mode": "raw",
              "raw": "{\"role\":\"sales_rep\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Suppliers",
      "item": [
        {
          "name": "List Suppliers",
          "request": {
            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/suppliers?page=1&limit=20", "host": ["{{BASE_URL}}"], "path": ["suppliers"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "Get Supplier by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/suppliers/{{SUPPLIER_ID}}" }
          }
        },
        {
          "name": "Create Supplier",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/suppliers" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gulf Charcoal Trading\",\n  \"country\": \"UAE\",\n  \"contactPersons\": [{\"name\": \"Mohammed Al-Mansoori\", \"phone\": \"+971 50 000001\", \"role\": \"Sales Director\"}],\n  \"charcoalTypes\": [{\"type\": \"BBQ hardwood\", \"grade\": \"A\"}],\n  \"paymentTerms\": \"50% upfront, 50% on BL\",\n  \"leadTimeDays\": 30\n}"
            }
          }
        },
        {
          "name": "Update Supplier",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/suppliers/{{SUPPLIER_ID}}" },
            "body": {
              "mode": "raw",
              "raw": "{\"paymentTerms\": \"40% upfront, 60% on BL\", \"leadTimeDays\": 35}"
            }
          }
        }
      ]
    },
    {
      "name": "Containers",
