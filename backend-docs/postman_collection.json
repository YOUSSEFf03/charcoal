        },
        {
          "name": "Create Container",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/containers" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"CONT-2024-003\",\n  \"supplierId\": \"{{SUPPLIER_ID}}\",\n  \"status\": \"port\",\n  \"notes\": \"Arriving end of month\"\n}"
            }
          }
        },
        {
          "name": "Mark Container as Arrived (auto-creates lots)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/containers/{{CONTAINER_ID}}" },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"arrived\", \"arrivalDate\": \"2024-05-26\"}"
            }
          }
        },
        {
          "name": "Add Container Expense",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/containers/{{CONTAINER_ID}}/expenses" },
            "body": {
              "mode": "raw",
              "raw": "{\"description\": \"Late invoice — agent fees\", \"amount\": \"120.00\"}"
            }
          }
        },
        {
          "name": "Get Container Expenses",
          "request": {
            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/containers/{{CONTAINER_ID}}/expenses" }
          }
        },
        {
          "name": "Add Product Line",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/containers/{{CONTAINER_ID}}/product-lines" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"charcoalType\": \"BBQ hardwood\",\n  \"grade\": \"A\",\n  \"supplierId\": \"{{SUPPLIER_ID}}\",\n  \"paidBags\": 800,\n  \"giftBags\": 20,\n  \"kgPerBag\": \"10.000\",\n  \"pricePerTon\": \"280.00\"\n}"
            }
          }
        },
        {
          "name": "Set Discount",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/containers/{{CONTAINER_ID}}/discount" },
            "body": {
              "mode": "raw",
              "raw": "{\"amount\": \"100.00\"}"
            }
          }
        }
      ]
    },
