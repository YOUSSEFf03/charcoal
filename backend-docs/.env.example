# ─────────────────────────────────────────────────────────────────────────────
# Charcoal Business Accounting System — Environment Variables
# Copy this file to .env.local (web) or .env (mobile) and fill in real values.
# NEVER commit the actual .env files to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL for the backend API. In development: http://localhost:3000
# In production: your Railway deployment URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# ── DATABASE ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string from Railway
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/charcoal_dev

# ── CLERK AUTH ────────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs (required by @clerk/nextjs)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk webhook secret — for syncing users to your database
# Create at: Clerk dashboard → Webhooks → Add endpoint (POST /api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=whsec_...

# ── MOBILE (Expo) ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# On physical device, use your computer's LAN IP during development:
EXPO_PUBLIC_API_URL=http://192.168.1.x:3000

# ── CURRENCY ──────────────────────────────────────────────────────────────────
# Default LBP exchange rate to USD (used in reports for conversion)
# Update this when the rate changes. Format: how many LBP = 1 USD
LBP_TO_USD_RATE=89500

# ── FEATURE FLAGS ─────────────────────────────────────────────────────────────
# Enable MSW mock service worker in development (true/false)
NEXT_PUBLIC_USE_MOCK_API=false

# Enable detailed Prisma query logging (true/false)
PRISMA_QUERY_LOGGING=false

# ── NODE ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
